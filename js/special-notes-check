/* 급여제공기록지 특이사항 검증
   - XLSX 필요: https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js
   - HTML에서 각 input id 유지 필요
*/
(() => {
  const state = {
    records: [], attendance: [], meals: [], baths: [], counsels: [],
    required: [], results: [], typeFilter: 'all'
  };

  const $ = (id) => document.getElementById(id);
  const today = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  const todayStr = `${today.getFullYear()}-${pad(today.getMonth()+1)}-${pad(today.getDate())}`;
  $('dateInput').value = todayStr;
  $('monthInput').value = todayStr.slice(0, 7);

  const normalize = (v) => String(v ?? '').replace(/\s+/g, '').trim();
  const cleanName = (v) => String(v ?? '').replace(/\s+/g, '').replace(/어르신|님/g, '').trim();
  const text = (v) => String(v ?? '').trim();

  function excelDateToISO(v) {
    if (!v && v !== 0) return '';
    if (v instanceof Date && !isNaN(v)) return `${v.getFullYear()}-${pad(v.getMonth()+1)}-${pad(v.getDate())}`;
    if (typeof v === 'number') {
      const d = XLSX.SSF.parse_date_code(v);
      if (d) return `${d.y}-${pad(d.m)}-${pad(d.d)}`;
    }
    const s = String(v).trim();
    const m = s.match(/(20\d{2})[.\-/년\s]*(\d{1,2})[.\-/월\s]*(\d{1,2})/);
    if (m) return `${m[1]}-${pad(m[2])}-${pad(m[3])}`;
    const m2 = s.match(/(\d{1,2})[.\-/월\s]*(\d{1,2})/);
    if (m2) {
      const y = ($('monthInput').value || todayStr.slice(0,7)).slice(0,4);
      return `${y}-${pad(m2[1])}-${pad(m2[2])}`;
    }
    return s;
  }

  function getTime(v) {
    if (!v && v !== 0) return '';
    if (typeof v === 'number') {
      const total = Math.round(v * 24 * 60);
      return `${pad(Math.floor(total / 60) % 24)}:${pad(total % 60)}`;
    }
    const s = String(v).trim();
    const m = s.match(/(\d{1,2})[:시]\s*(\d{1,2})?/);
    if (!m) return '';
    return `${pad(m[1])}:${pad(m[2] || '00')}`;
  }

  function timeToMin(t) {
    const m = String(t).match(/(\d{1,2}):(\d{2})/);
    return m ? Number(m[1]) * 60 + Number(m[2]) : null;
  }

  function headerKey(h) {
    return normalize(h).toLowerCase();
  }

  function findHeaderRow(rows) {
    const keys = ['수급자명','성명','어르신','식당일','일자','날짜','특이사항','점심','석식','하원'];
    let best = 0, score = -1;
    rows.slice(0, 20).forEach((r, idx) => {
      const joined = r.map(headerKey).join('|');
      const s = keys.reduce((acc, k) => acc + (joined.includes(headerKey(k)) ? 1 : 0), 0);
      if (s > score) { score = s; best = idx; }
    });
    return best;
  }

  function findCol(headers, candidates) {
    const hs = headers.map(headerKey);
    for (const c of candidates) {
      const ck = headerKey(c);
      const idx = hs.findIndex(h => h === ck || h.includes(ck) || ck.includes(h));
      if (idx >= 0) return idx;
    }
    return -1;
  }

  async function readWorkbook(file) {
    if (!file) return [];
    const buf = await file.arrayBuffer();
    const wb = XLSX.read(buf, { type:'array', cellDates:true });
    const all = [];
    wb.SheetNames.forEach(sheetName => {
      const ws = wb.Sheets[sheetName];
      const rows = XLSX.utils.sheet_to_json(ws, { header:1, defval:'' });
      if (rows.length) all.push({ sheetName, rows });
    });
    return all;
  }

  async function parseGeneric(file, kind) {
    const sheets = await readWorkbook(file);
    const out = [];
    sheets.forEach(({ sheetName, rows }) => {
      const hr = findHeaderRow(rows);
      const headers = rows[hr] || [];
      const nameCol = findCol(headers, ['수급자명','성명','어르신','대상자명','이름']);
      const dateCol = findCol(headers, ['식당일','일자','날짜','제공일','서비스일','작성일']);
      const noteCol = findCol(headers, ['특이사항','비고','내용','수급자반응및특이사항']);
      const lunchCol = findCol(headers, ['점심','중식','오찬']);
      const dinnerCol = findCol(headers, ['석식','저녁']);
      const leaveCol = findCol(headers, ['하원','퇴실','귀가','종료시간']);
      const bathCol = findCol(headers, ['목욕','몸씻기']);
      const changeCol = findCol(headers, ['변경내용','내용','상담내용','특이사항','급여변경']);
      for (let i = hr + 1; i < rows.length; i++) {
        const r = rows[i];
        const name = cleanName(r[nameCol]);
        if (!name) continue;
        out.push({
          kind, sheetName, rowNo: i + 1, name,
          date: excelDateToISO(dateCol >= 0 ? r[dateCol] : ''),
          note: text(noteCol >= 0 ? r[noteCol] : ''),
          lunch: text(lunchCol >= 0 ? r[lunchCol] : ''),
          dinner: text(dinnerCol >= 0 ? r[dinnerCol] : ''),
          leaveTime: getTime(leaveCol >= 0 ? r[leaveCol] : ''),
          bath: text(bathCol >= 0 ? r[bathCol] : ''),
          change: text(changeCol >= 0 ? r[changeCol] : '')
        });
      }
    });
    return out;
  }

  function isNo(v) {
    const s = normalize(v);
    return !s || /^(x|×|미|무|안|결|0|-)$/.test(s) || /(미실시|미제공|거부|안드|안드심|미섭취|결식|없음|공란)/.test(s);
  }
  function isYes(v) {
    const s = normalize(v);
    return /^(o|○|◯|1|완|실시|제공)$/.test(s) || /(드심|섭취|제공|실시|완료)/.test(s);
  }

  function addRequired(arr, item) {
    const key = `${item.name}|${item.date}|${item.type}|${item.code}`;
    if (!arr.some(x => `${x.name}|${x.date}|${x.type}|${x.code}` === key)) arr.push(item);
  }

  function buildRequired() {
    const date = $('dateInput').value;
    const month = $('monthInput').value;
    const earlyMin = timeToMin($('earlyTimeInput').value || '16:30');
    const arr = [];

    state.meals.forEach(m => {
      if (date && m.date && m.date !== date) return;
      if (!date && month && !m.date.startsWith(month)) return;
      if (m.lunch && isNo(m.lunch)) addRequired(arr, req(m, '식사', 'LUNCH_NO', '점심을 드시지 않으심.', ['점심'], ['안드','안드심','미섭취','거부','결식','드시지']));
      if (m.dinner && isNo(m.dinner)) addRequired(arr, req(m, '식사', 'DINNER_NO', '석식을 드시지 않으심.', ['석식','저녁'], ['안드','안드심','미섭취','거부','결식','드시지']));
    });

    state.attendance.forEach(a => {
      if (date && a.date && a.date !== date) return;
      if (!date && month && !a.date.startsWith(month)) return;
      const leave = timeToMin(a.leaveTime);
      if (leave !== null && earlyMin !== null && leave < earlyMin) {
        addRequired(arr, req(a, '송영', 'EARLY_LEAVE', `${a.leaveTime} 조기 하원하심.`, ['조기','일찍','빠른','귀가','하원'], ['하원','귀가','퇴실']));
      }
    });

    state.baths.forEach(b => {
      if (date && b.date && b.date !== date) return;
      if (!date && month && !b.date.startsWith(month)) return;
      const target = b.bath || b.note;
      if (/거부/.test(target)) addRequired(arr, req(b, '목욕', 'BATH_REFUSE', '목욕을 거부하심.', ['목욕'], ['거부']));
      else if (target && isNo(target)) addRequired(arr, req(b, '목욕', 'BATH_NO', '목욕을 실시하지 못하심.', ['목욕'], ['미실시','못하','안하','제공하지','실시하지']));
    });

    state.counsels.forEach(c => {
      if (date && c.date && c.date !== date) return;
      if (!date && month && !c.date.startsWith(month)) return;
      const s = `${c.change} ${c.note}`;
      const ns = normalize(s);
      if (/목욕|몸씻기/.test(ns)) {
        if (/제외|중지|삭제|종료|안함|미제공/.test(ns)) addRequired(arr, req(c, '상담일지', 'BATH_END', '오늘부터 목욕 제외 대상이심.', ['오늘부터','금일부터','목욕'], ['제외','중지','종료','안함','미제공']));
        else addRequired(arr, req(c, '상담일지', 'BATH_START', '오늘부터 목욕 제공 대상이심.', ['오늘부터','금일부터','목욕'], ['제공','시작','추가','받으']));
      }
      if (/다진/.test(ns)) addRequired(arr, req(c, '상담일지', 'MINCED_FOOD', '오늘부터 다진식으로 변경되심.', ['다진'], ['변경','제공','오늘부터','금일부터']));
      if (/죽식|죽/.test(ns)) addRequired(arr, req(c, '상담일지', 'PORRIDGE', '오늘부터 죽식으로 변경되심.', ['죽식','죽'], ['변경','제공','오늘부터','금일부터']));
      if (/복약|투약|약/.test(ns)) addRequired(arr, req(c, '투약', 'MED_CHANGE', '오늘부터 복약도움 내용이 변경되심.', ['복약','투약','약'], ['변경','도움','오늘부터','금일부터']));
    });
    state.required = arr;
  }

  function req(src, type, code, requiredText, groupA, groupB) {
    return { name: src.name, date: src.date || $('dateInput').value, type, code, requiredText, groupA, groupB, source: `${src.sheetName || ''} ${src.rowNo ? src.rowNo + '행' : ''}`.trim(), recommend: recommendText(type, code, src) };
  }

  function recommendText(type, code, src) {
    const t = {
      LUNCH_NO: '점심을 제공하였으나 드시지 않으셨으며 전반적인 상태를 지속적으로 관찰하였음.',
      DINNER_NO: '석식을 제공하였으나 드시지 않으셨으며 전반적인 상태를 지속적으로 관찰하였음.',
      EARLY_LEAVE: `${src.leaveTime || ''} 보호자 요청 또는 개인 사정으로 조기 하원하심.`,
      BATH_REFUSE: '목욕을 권유하였으나 거부 의사를 표현하셔서 무리하지 않고 상태를 관찰하였음.',
      BATH_NO: '목욕 제공 대상이나 당일 사정으로 목욕을 실시하지 못하였으며 추후 제공 여부를 확인하기로 함.',
      BATH_START: '상담일지 변경에 따라 금일부터 목욕 서비스를 제공받으심.',
      BATH_END: '상담일지 변경에 따라 금일부터 목욕 서비스 제공 대상에서 제외되심.',
      MINCED_FOOD: '상담일지 변경에 따라 금일부터 다진식으로 변경하여 제공하였음.',
      PORRIDGE: '상담일지 변경에 따라 금일부터 죽식으로 변경하여 제공하였음.',
      MED_CHANGE: '상담일지 변경에 따라 금일부터 복약도움 내용이 변경되어 제공하였음.'
    };
    return t[code] || `${type} 관련 특이사항을 기록해야 함.`;
  }

  function findUploadedNote(item) {
    const candidates = state.records.filter(r => r.name === item.name && (!item.date || !r.date || r.date === item.date));
    return candidates.map(r => r.note).filter(Boolean).join('\n---\n');
  }

  function hasKeywords(note, aList, bList) {
    const n = normalize(note);
    if (!n) return false;
    const aOk = !aList?.length || aList.some(k => n.includes(normalize(k)));
    const bOk = !bList?.length || bList.some(k => n.includes(normalize(k)));
    return aOk && bOk;
  }

  function compareResults() {
    state.results = state.required.map(item => {
      const uploaded = findUploadedNote(item);
      const ok = hasKeywords(uploaded, item.groupA, item.groupB);
      return {
        ...item, uploaded,
        status: ok ? 'ok' : (uploaded ? 'warn' : 'miss'),
        reason: ok ? '필수 키워드가 확인되었습니다.' : (uploaded ? '관련 문구가 부족하여 확인이 필요합니다.' : '업로드 특이사항에서 관련 내용이 확인되지 않습니다.')
      };
    });
  }

  function render() {
    const resultFilter = $('resultFilter').value;
    let rows = state.results;
    if (state.typeFilter !== 'all') rows = rows.filter(r => r.type === state.typeFilter);
    if (resultFilter !== 'all') rows = rows.filter(r => r.status === resultFilter);

    $('sumTotal').textContent = state.results.length;
    $('sumOk').textContent = state.results.filter(r => r.status === 'ok').length;
    $('sumMiss').textContent = state.results.filter(r => r.status === 'miss').length;
    $('sumWarn').textContent = state.results.filter(r => r.status === 'warn').length;
    $('sumRecord').textContent = state.records.filter(r => r.note).length;

    const body = $('resultBody');
    if (!rows.length) {
      body.innerHTML = `<tr><td colspan="8" class="empty">표시할 결과가 없습니다.</td></tr>`;
      return;
    }
    body.innerHTML = rows.map((r, idx) => `
      <tr>
        <td>${badge(r.status)}</td>
        <td><b>${escapeHtml(r.name)}</b><div class="small">${escapeHtml(r.source || '')}</div></td>
        <td>${escapeHtml(r.date || '')}</td>
        <td>${escapeHtml(r.type)}</td>
        <td class="note-text">${escapeHtml(r.requiredText)}</td>
        <td class="note-text">${escapeHtml(r.uploaded || '없음')}</td>
        <td>${escapeHtml(r.reason)}</td>
        <td class="note-text">${escapeHtml(r.recommend)}<br><button class="copy-btn" data-copy="${idx}">복사</button></td>
      </tr>`).join('');

    body.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const r = rows[Number(btn.dataset.copy)];
        navigator.clipboard.writeText(r.recommend);
        btn.textContent = '복사됨';
        setTimeout(() => btn.textContent = '복사', 900);
      });
    });
  }

  function badge(status) {
    if (status === 'ok') return '<span class="badge badge-ok">정상</span>';
    if (status === 'miss') return '<span class="badge badge-miss">누락</span>';
    return '<span class="badge badge-warn">확인필요</span>';
  }
  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>'"]/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[m]));
  }

  async function run() {
    $('runBtn').disabled = true;
    $('runBtn').textContent = '검증 중...';
    try {
      state.records = await parseGeneric($('recordFile').files[0], 'record');
      state.attendance = await parseGeneric($('attendanceFile').files[0], 'attendance');
      state.meals = await parseGeneric($('mealFile').files[0], 'meal');
      state.baths = await parseGeneric($('bathFile').files[0], 'bath');
      state.counsels = await parseGeneric($('counselFile').files[0], 'counsel');
      buildRequired();
      compareResults();
      render();
    } catch (err) {
      console.error(err);
      alert('검증 중 오류가 발생했습니다. 파일의 머릿행/열 이름을 확인해주세요.');
    } finally {
      $('runBtn').disabled = false;
      $('runBtn').textContent = '검증하기';
    }
  }

  function downloadResult() {
    if (!state.results.length) return alert('다운로드할 결과가 없습니다. 먼저 검증해주세요.');
    const rows = state.results.map(r => ({
      결과: r.status === 'ok' ? '정상' : r.status === 'miss' ? '누락' : '확인필요',
      어르신: r.name, 일자: r.date, 구분: r.type,
      필요특이사항: r.requiredText, 업로드특이사항: r.uploaded,
      판정사유: r.reason, 추천문구: r.recommend, 근거: r.source
    }));
    const ws = XLSX.utils.json_to_sheet(rows);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, '특이사항검증결과');
    XLSX.writeFile(wb, `특이사항검증결과_${$('dateInput').value || $('monthInput').value}.xlsx`);
  }

  function showSample() {
    alert(`인식 가능한 열 이름 예시\n\n급여제공기록지: 수급자명 / 식당일 또는 일자 / 특이사항\n출석관리: 수급자명 / 일자 / 하원시간\n식사 기록: 수급자명 / 일자 / 점심 / 석식\n목욕 기록: 수급자명 / 일자 / 목욕 또는 특이사항\n상담일지: 수급자명 / 작성일 또는 변경일 / 변경내용 또는 상담내용`);
  }

  $('runBtn').addEventListener('click', run);
  $('downloadBtn').addEventListener('click', downloadResult);
  $('sampleBtn').addEventListener('click', showSample);
  $('resetBtn').addEventListener('click', () => location.reload());
  $('resultFilter').addEventListener('change', render);
  document.querySelectorAll('.pill-filter button').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.pill-filter button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.typeFilter = btn.dataset.type;
      render();
    });
  });
})();
